{
  "name": "@agents-kanban/react",
  "version": "0.2.0",
  "description": "The agents_kanban board for a React 18 host: Board, CardDialog, MarkdownEditor over an injected KanbanApi; the board's shape from the server's config.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./kanban.css": "./src/styles/kanban.css",
    "./base.css": "./src/styles/base.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 --report-unused-disable-directives .",
    "format": "cd .. && prettier --write \"**/*.{ts,tsx,js,css,json}\"",
    "format:check": "cd .. && prettier --check \"**/*.{ts,tsx,js,css,json}\""
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3"
  }
}
