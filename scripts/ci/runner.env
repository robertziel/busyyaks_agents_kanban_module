# The public CI runner's CPU count, which every react stage copies: Jenkins, GitHub Actions and any machine's
# scripts/ci/test.sh.
#
# CI_RUNNER_CPUS: GitHub's ubuntu-latest runner for a public repository has 4 vCPUs. The react container gets that much
# CPU TIME (docker --cpus N: a CFS quota on no fixed cores, so concurrent Jenkins builds spread over the host) and vitest
# runs N workers. More workers than CPU time timed out random tests (reproduced at --cpus 1 with
# 32 workers and at --cpus 2 with 8).
CI_RUNNER_CPUS=4
