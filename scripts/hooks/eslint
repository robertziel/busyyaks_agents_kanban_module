#!/usr/bin/env bash
# ESLint on the staged TS/TSX files under <dir> (an overcommit ad hoc hook, .overcommit.yml). Runs in <dir>
# of the staged snapshot with its eslint.config.js, the same flags as `npm run lint` there; the type-aware rules see
# the whole staged project. node_modules = /deps/node_modules (the image's npm ci of <dir>/package-lock.json).
set -euo pipefail

dir=${1:?usage: eslint <dir>}
cd "/deps/snap/$dir"
files=()
while IFS= read -r -d '' f; do files+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR --relative -z -- '*.ts' '*.tsx')
[ ${#files[@]} -gt 0 ] || exit 0
# --no-warn-ignored: a staged file the config itself ignores is not linted by CI either
exec /deps/node_modules/.bin/eslint --max-warnings 0 --report-unused-disable-directives --no-warn-ignored "${files[@]}"
